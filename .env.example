# WordPress site — keep this file out of git (chmod 600 .env)
# For another site, copy this folder with a different SITE_NAME and DOMAIN.

# Required
SITE_NAME=wordpress
DOMAIN=blog.example.com
# Must match the existing database user's password
DB_PASSWORD=
# Only used when the database is first created; changing it later has no effect
DB_ROOT_PASSWORD=

# Image versions — pin exact tags
# WordPress tag controls PHP/Apache only (core updates itself in wp-admin)
WORDPRESS_VERSION=php8.5-apache
# Pin the series, e.g. 11.8 — never "lts" together with auto-upgrade
MARIADB_VERSION=11.8

# Database identity — must match the existing database
DB_NAME=wordpress
DB_USER=wordpress
WORDPRESS_TABLE_PREFIX=wp_

# Access control
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# PHP / Apache
PHP_UPLOAD_MAX_FILESIZE=64M
WORDPRESS_PHP_MEMORY_LIMIT=256M
# Peak memory ≈ MAX_WORKERS x typical request memory (often 40–80M, up to the
# PHP limit). Keep it within WORDPRESS_MEMORY_LIMIT.
WORDPRESS_MAX_WORKERS=12
# Frontend network (shared with Traefik) — dual-stack, unique per site
WORDPRESS_NETWORK_SUBNET_V4=10.100.0.0/24
WORDPRESS_NETWORK_SUBNET_V6=fd00:100::/64
# Internal database network — dual-stack, unique per site
WORDPRESS_DB_NETWORK_SUBNET_V4=10.101.0.0/24
WORDPRESS_DB_NETWORK_SUBNET_V6=fd00:101::/64

# Optional overrides
TZ=Europe/Athens
WORDPRESS_CPU_LIMIT=2
WORDPRESS_MEMORY_LIMIT=1G
WORDPRESS_MEMORY_RESERVATION=256M
WORDPRESS_PIDS_LIMIT=256
DB_CPU_LIMIT=1
DB_MEMORY_LIMIT=512M
DB_MEMORY_RESERVATION=256M
DB_PIDS_LIMIT=256
DB_INNODB_BUFFER_POOL_SIZE=128M